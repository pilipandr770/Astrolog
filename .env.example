# --- Flask ---
FLASK_ENV=production
SECRET_KEY=change-me
DATABASE_PATH=./data/bot.db

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=https://your-evolution-instance.hostinger.example
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=astrologer-bot

# --- Anthropic (толкование Лал Китаб) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI Whisper (голосовые сообщения) ---
OPENAI_API_KEY=sk-xxxx
# Альтернатива: self-hosted faster-whisper, см. whisper_service.py
WHISPER_MODE=api   # api | local

# --- Геокодинг ---
GEOCODING_USER_AGENT=whatsapp-astrologer-bot

# --- Публичный URL сервера (ТОЛЬКО если сами хостите /payment/success и
# /payment/cancel — см. routes/payment_pages.py). Если не задан, для
# Stripe success/cancel редиректов используется wa.me-ссылка на бота
# (см. BOT_WHATSAPP_NUMBER) — публичный URL тогда вообще не нужен.
APP_BASE_URL=

# Номер бота в международном формате без "+"/пробелов, напр. 4915123456789
BOT_WHATSAPP_NUMBER=4915123456789

# --- Swiss Ephemeris ---
# Папка с .se1 файлами, см. docs/TODO.md откуда скачать
EPHE_PATH=./ephe

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_xxxx
# Нужен только если настроите вебхук (см. routes/stripe_webhook.py) —
# по умолчанию бот опрашивает статус оплаты сам, см. payment_poller.py
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_ID=price_xxxx
REPORT_PRICE_EUR=9.90

# --- Payment Polling (замена вебхука, см. app/services/payment_poller.py) ---
PAYMENT_POLL_INTERVAL_SECONDS=90
# На "false" — если запускаете gunicorn с несколькими workers и поллер
# отдельным процессом (python -m app.services.payment_poller), иначе
# каждый worker запустит свой поток и сообщения будут дублироваться.
ENABLE_INPROCESS_PAYMENT_POLLER=true

# --- Admin-панель (admin_app.py, отдельный процесс на ADMIN_PORT,
# см. docker-compose.yml — порт НЕ публикуется наружу, только 127.0.0.1) ---
ADMIN_PASSWORD=change-me
ADMIN_PORT=5001
# URL встроенного Evolution API Manager (QR-код для подключения номера) —
# ссылка на него будет в дашборде админки.
EVOLUTION_MANAGER_URL=http://localhost:8080/manager

# --- Нахгол-Sync verpasster WhatsApp-Nachrichten (app/services/catchup.py) ---
ENABLE_CATCHUP_SYNC=true
CATCHUP_MIN_INTERVAL_SECONDS=60

# --- Telegram (zweiter, unabhängiger Kanal — app/services/telegram_api.py) ---
TELEGRAM_BOT_TOKEN=
# Bot-Username ohne "@" — für den t.me-Redirect-Link nach Stripe Checkout.
TELEGRAM_BOT_USERNAME=
